package utils;

import java.util.Properties;

public class ConfigLoader {

    private static ConfigLoader instance;
    private Properties properties;

    private ConfigLoader() {
        properties = PropertyUtils.propertyLoader("src/test/resources/config.properties");
    }

    public static ConfigLoader getInstance() {
        if (instance == null) {
            instance = new ConfigLoader();
        }
        return instance;
    }

    public String getBaseUrl() {
        String baseUrl = properties.getProperty("baseUrl");
        if (baseUrl != null) return baseUrl;
        throw new RuntimeException("baseUrl not specified in config.properties");
    }

    public String getBrowser() {
        String browser = properties.getProperty("browser");
        if (browser != null) return browser;
        throw new RuntimeException("browser not specified in config.properties");
    }

    public String getChromeDriverPath() {
        String path = properties.getProperty("webdriver.chrome.driver");
        if (path != null) return path;
        throw new RuntimeException("webdriver.chrome.driver not specified in config.properties");
    }
}

